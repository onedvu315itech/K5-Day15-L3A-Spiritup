# Chép file này thành .env rồi điền (Windows: copy .env.example .env · macOS/Linux: cp .env.example .env).
# KHÔNG commit .env (đã có trong .gitignore). Không dán key vào code, slide, ảnh chụp màn hình.
# BTC KHÔNG cấp API key: dùng gói miễn phí hoặc tài khoản của nhóm (xem docs/connect-model.md).
# MODEL_PROVIDER: để trống hoặc fake = chế độ giả (chưa gọi model) · gemini / openai / anthropic / ollama …
# MODEL_NAME: mã gọi API của model, đúng như tài liệu nhà cung cấp.
MODEL_PROVIDER=
# Với GWAI, đặt MODEL_PROVIDER=gwai và MODEL_NAME theo model được cấp (vd. gemini-3.8-flash: tự gọi dạng generateContent).
GWAI_API_KEY=
MODEL_NAME=
API_KEY=

# --- Web app Partaway (backend trên Render, xem ARCHITECTURE.md mục 8) ---
# Chuỗi kết nối Supabase qua connection pooler, ví dụ postgresql://user:pass@host:6543/postgres
DATABASE_URL=
GOOGLE_MAPS_API_KEY=
# Công cụ bản đồ dự phòng và tra giờ mở cửa, giá/người
VIETMAP_API_KEY=
TAVILY_API_KEY=
# Geoapify (Places, Geocoding, Routing), đề xuất thay Google: docs/roa-agent-design.md
GEOAPIFY_API_KEY=
# Domain frontend được gọi API, phân cách bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000
# Gốc URL frontend để dựng link mời
FRONTEND_BASE_URL=http://localhost:3000
# Kho địa điểm theo thành phố (docs/DATABASE.md mục 5). STORE_TTL_DAYS để trống: kho không hết hạn (OQ-12 chưa chốt)
STORE_TTL_DAYS=
STORE_MAX_CAFE=60
STORE_MAX_FOOD=60
STORE_MAX_LODGING=30
# Số chỗ ở được tra giá phòng bằng Tavily mỗi đợt thu (cần TAVILY_API_KEY)
STORE_PRICED_LODGING=10
# Thẻ đề xuất mở trong bao lâu rồi thành tham khảo (CR-001, chờ duyệt)
PROPOSAL_TTL_HOURS=48
# Frontend (frontend/.env.local trên máy, biến môi trường trên Vercel)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
